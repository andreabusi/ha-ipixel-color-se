{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "description": "Choose an iPixel display in range, or enter its Bluetooth address.",
        "data": {
          "address": "Display"
        }
      },
      "bluetooth_confirm": {
        "description": "Set up {ble_name} ({address})?",
        "data": {
          "name": "Name"
        },
        "data_description": {
          "name": "Prefixes the names of all the display's entities. For example, \"Kitchen Pixel\" gives binary_sensor.kitchen_pixel_connected."
        }
      },
      "manual": {
        "description": "The display must be in range of Home Assistant's Bluetooth adapter or of a Bluetooth proxy.",
        "data": {
          "address": "Bluetooth address",
          "name": "Name"
        },
        "data_description": {
          "address": "For example 12:34:56:78:9A:BC.",
          "name": "Prefixes the names of all the display's entities. For example, \"Kitchen Pixel\" gives binary_sensor.kitchen_pixel_connected."
        }
      }
    },
    "error": {
      "cannot_connect": "Can't connect to the display. Check that it's powered on, in range, and not connected to the phone app, then try again.",
      "invalid_address": "Enter a Bluetooth address like 12:34:56:78:9A:BC.",
      "unsupported_panel": "The display answered, but its type isn't supported.",
      "unknown": "Unexpected error. Check the Home Assistant log."
    },
    "abort": {
      "already_configured": "This display is already set up.",
      "already_in_progress": "This display is already being set up."
    }
  },
  "selector": {
    "device": {
      "options": {
        "manual": "Enter address manually"
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "connected": {
        "name": "Connected"
      }
    },
    "button": {
      "sync_time": {
        "name": "Sync time"
      },
      "disconnect": {
        "name": "Disconnect"
      }
    },
    "media_player": {
      "image_player": {
        "name": "Image player"
      }
    },
    "number": {
      "brightness": {
        "name": "Brightness"
      }
    },
    "select": {
      "mode": {
        "name": "Mode",
        "state": {
          "clock": "Clock",
          "image": "Image"
        }
      },
      "clock_style": {
        "name": "Clock style",
        "state": {
          "planet_yellow": "Planet, yellow",
          "planet_gradient": "Planet, gradient",
          "planet_blue": "Planet, blue",
          "frame_gradient": "Frame, gradient",
          "frame_yellow": "Frame, yellow",
          "frame_multicolor": "Frame, multicolor",
          "hourglass_yellow": "Hourglass, yellow",
          "hourglass_orange": "Hourglass, orange"
        }
      },
      "image_fit": {
        "name": "Image fit",
        "state": {
          "fill": "Fill",
          "fit": "Fit"
        }
      },
      "orientation": {
        "name": "Orientation",
        "state": {
          "normal": "Normal",
          "rotated_counterclockwise": "Rotated 90° counterclockwise",
          "upside_down": "Upside down",
          "rotated_clockwise": "Rotated 90° clockwise"
        }
      }
    },
    "sensor": {
      "width": {
        "name": "Width"
      },
      "height": {
        "name": "Height"
      },
      "signal_strength": {
        "name": "Signal strength"
      }
    },
    "switch": {
      "power": {
        "name": "Power"
      },
      "clock_24h": {
        "name": "Clock 24-hour format"
      },
      "clock_show_date": {
        "name": "Clock show date"
      },
      "auto_reconnect": {
        "name": "Auto reconnect"
      }
    }
  },
  "exceptions": {
    "not_reachable": {
      "message": "Can't connect to {name}. Check that it's powered on, in range, and not connected to the phone app"
    },
    "command_failed": {
      "message": "{name} didn't accept the command: {error}"
    },
    "no_image": {
      "message": "{name} has no image to show yet. Play one with the image player first"
    },
    "image_too_large": {
      "message": "The image {source} is larger than {limit} MB"
    },
    "image_unsupported": {
      "message": "{source} isn't an image the display can show. Use a GIF, PNG, JPEG, WebP or BMP file"
    },
    "image_unavailable": {
      "message": "Can't read the image {source}: {error}"
    }
  }
}
